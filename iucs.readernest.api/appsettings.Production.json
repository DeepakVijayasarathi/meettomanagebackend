{
  // Empty here — not absent — deliberately: appsettings.json's baked-in ConnectionStrings
  // value is a stale, real host/password from before Production got its own settings file.
  // Leaving it as the only source meant a container started without
  // ConnectionStrings__ReaderNestDb set would boot successfully and silently write to that
  // stale database instead of the one it's meant to. Env vars already override this JSON
  // layer, so a correctly-configured deploy is unaffected; a misconfigured one now fails
  // loudly at startup via Program.cs's connection-string guard instead of connecting to the
  // wrong place.
  "ConnectionStrings": {
    "ReaderNestDb": ""
  }
}
